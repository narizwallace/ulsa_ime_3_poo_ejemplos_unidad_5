{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Crear carpeta build",
            "type": "shell",
            "command": "mkdir -p build",
            "windows": {
                "command": "if (-not (Test-Path build)) { New-Item -ItemType Directory build | Out-Null }",
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            },
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        },
        {
            "label": "Compilar y ejecutar ejemplo",
            "type": "shell",
            "command": "g++ -Wall -Wextra -std=c++17 -Iinclude \"${file}\" -o \"build/${fileBasenameNoExtension}\" && \"./build/${fileBasenameNoExtension}\"",
            "windows": {
                "command": "g++ -Wall -Wextra -std=c++17 -Iinclude \"${file}\" -o \"build/${fileBasenameNoExtension}.exe\"; if ($LASTEXITCODE -eq 0) { & \"./build/${fileBasenameNoExtension}.exe\" }",
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            },
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Crear carpeta build",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
